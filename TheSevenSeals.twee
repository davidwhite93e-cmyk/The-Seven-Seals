:: Startup {"position":"225,625","size":"100,100"}
/*==================================================
                STARTUP WIDGETS
==================================================*/

/*--------------------------------------------------
Relationship
Usage: <<relationship "yasmina" 2>>
--------------------------------------------------*/
<<widget "relationship">>
	<<set $npc[_args[0]].relationship += _args[1]>>
	<<set $npc[_args[0]].relationship = Math.clamp($npc[_args[0]].relationship, -25, $settings.maxRelationship)>>
	<<if $settings.relationshipPopups>>
		<<replace "#sidebar-alert">><</replace>>
	<</if>>
<</widget>>

/*--------------------------------------------------
Reputation
Usage: <<reputation "city" 1>>
--------------------------------------------------*/
<<widget "reputation">>
	<<set $reputation[_args[0]] += _args[1]>>
<</widget>>

/*--------------------------------------------------
Personality
Usage: <<personality "honor" 1>>
--------------------------------------------------*/
<<widget "personality">>
	<<set $personality[_args[0]] += _args[1]>>
<</widget>>

/*--------------------------------------------------
Journal
Usage: <<journal "Met Yasmina.">>
--------------------------------------------------*/
<<widget "journal">>
	<<run $journal.push(_args[0])>>
<</widget>>

/*--------------------------------------------------
Codex
Usage: <<codex "people" "Yasmina">>
--------------------------------------------------*/
<<widget "codex">>
	<<if !$codex[_args[0]].includes(_args[1])>>
		<<run $codex[_args[0]].push(_args[1])>>
	<</if>>
<</widget>>

/*--------------------------------------------------
Objective
Usage: <<objective "Visit the marketplace.">>
--------------------------------------------------*/
<<widget "objective">>
	<<set $quest.objective = _args[0]>>
<</widget>>

/*--------------------------------------------------
Gold
--------------------------------------------------*/
<<widget "gainGold">>
	<<set $currency.silver += _args[0]>>
<</widget>>

<<widget "loseGold">>
	<<set $currency.silver -= _args[0]>>
	<<if $currency.silver < 0>>
		<<set $currency.silver = 0>>
	<</if>>
<</widget>>

/*--------------------------------------------------
Health
--------------------------------------------------*/
<<widget "damage">>
	<<set $player.health -= _args[0]>>
	<<if $player.health < 0>>
		<<set $player.health = 0>>
	<</if>>
<</widget>>

<<widget "heal">>
	<<set $player.health += _args[0]>>
	<<if $player.health > $player.maxHealth>>
		<<set $player.health = $player.maxHealth>>
	<</if>>
<</widget>>


